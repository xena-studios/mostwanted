# MostWanted (core): the full config, filled in by start.sh at every start with the database
# settings from Raptor (or .env). Keep it in step with core/src/main/resources/config.yml.
# Changes need a restart.

# PostgreSQL, shared with LuckPerms, LibertyBans and the backend. MostWanted
# won't start without it: playing on a blank state would overwrite real ones.
database:
  host: ${DB_HOST}
  port: ${DB_PORT}
  name: ${DB_NAME}
  user: ${DB_USER}
  password: '${DB_PASSWORD}'
  # Connections kept open. Few are needed: every write goes through one thread.
  pool-size: 4

# How often changed players are written to the database. A crash loses at most
# this much; quitting and stopping the server always save.
save-every-seconds: 5

# The clock on the scoreboard. One zone for everyone, so screenshots match the logs.
clock:
  timezone: America/New_York
  label: ET

# The gameplay numbers. Leave a line out to use the default shown.
rules:
  # Arrested players serve base + seconds-per-step for every bounty-per-step of
  # bounty, up to max: 1 minute, plus 1 per $2,500, up to 5.
  sentence:
    base-seconds: 60
    seconds-per-step: 60
    bounty-per-step: 2500
    max-seconds: 300
  # A guard who kills a criminal gets this share of the bounty; cuffing pays it all.
  kill-share-percent: 50
  # Added to a criminal's bounty for killing an on-duty guard.
  guard-kill-bounty: 500
  # How close a guard must be to cuff someone, in blocks.
  cuff-range: 3
  # A guard can't go off duty this soon after a fight.
  combat-tag-seconds: 15

# Robberies. Every robbery zone (/mw zone create <name> robbery) is a spot: it
# opens, a criminal walking in starts it and the alarm goes off for guards, and
# the robbers must stay inside until the time is up. The payout is split between
# them; each gets the bounty. A spot without its own section uses the defaults.
robberies:
  defaults:
    seconds: 60
    payout: 2500
    bounty: 1500
    closed-minutes: 10
  # A spot's section is its zone name. name is what players see.
  bank:
    name: Bank
    seconds: 120
    payout: 10000
    bounty: 5000
    closed-minutes: 15
  # More guards on duty, more risk, more reward: +10% each, up to +100%.
  payout-per-guard-percent: 10
  max-guard-bonus-percent: 100

# How long logs are kept. The privacy page (mostwantedmc.com/privacy) promises
# these numbers: change it too if you change them.
retention:
  # The server's log files: chat, commands and IP addresses.
  server-log-days: 90
  # The game log: arrests, robberies and staff actions.
  game-log-months: 12

# Escape routes. Mark weak walls with /mw zone create <name> wall: inmates (and
# criminals breaking in) punch a block wall-hits times, no more than hit-gap-ms
# apart, to break it; it grows back. Gates (/mw zone create <name> gate) open for a
# guard, or for anyone holding a keycard. Guards carry one on duty.
escapes:
  wall-hits: 20
  hit-gap-ms: 1500
  wall-regrow-seconds: 120
  gate-open-seconds: 5
  # The chance a guard's keycard drops when they die.
  keycard-drop-percent: 50

# Riots. Mark the alarm with /mw zone create <name> alarm, in the yard. When enough
# inmates right-click inside it within the window, a riot starts: guards and inmates
# fight inside the prison, and guards can cuff inmates there. It ends on time, or
# once every rioter is caught.
riots:
  inmates-needed: 3
  press-window-seconds: 30
  length-minutes: 5
  cooldown-minutes: 30
  # Guards on duty needed to start one.
  min-guards: 1

# The resource pack (pack/ in the repo), published as the "pack" GitHub release.
# Java players get it as they join; its SHA-1 is read from sha1-url, so publishing
# a new pack needs no change here. Empty url turns it off. Without the pack, items
# show as the vanilla items they're made from: the game still works.
resource-pack:
  url: https://github.com/xena-studios/mostwanted/releases/download/pack/mostwanted-pack.zip
  sha1-url: https://github.com/xena-studios/mostwanted/releases/download/pack/mostwanted-pack.sha1
  required: true

# Store purchases (docs/11-store.md): MostWanted runs the commands Tebex queues, in
# place of the Tebex plugin. The webstore's secret key (Tebex: Integrations → Game
# servers); empty or none switches it off. A command runs only if it matches one of
# allowed-commands in full (regular expressions), so a leaked key can't run anything
# else. These are exactly the store's packages; add one for a new kind of package.
store:
  tebex-secret: '${TEBEX_SECRET}'
  allowed-commands:
    - 'lp user [A-Za-z0-9_.*]{1,32} parent add (vip|vip_plus|mvp|legend)'
    - 'lp user [A-Za-z0-9_.*]{1,32} permission set mostwanted\.cosmetic\.[a-z-]+ true'
    - 'mostwanted boost [A-Za-z0-9_.*]{1,32}'
  # The website: the store menu in game shows its catalogue (/store.json) and links
  # to its cart (/buy/<id>). Empty: the store menu shows nothing (for tests).
  website: https://mostwantedmc.com

# What players can see and run (Paper's command list and tab completion): only these.
# Everything else, plugin:command forms included, is hidden and refused like a command
# that doesn't exist. Staff with mostwanted.commands.all (helpers and up, and ops) see
# everything. Add a player command from a new plugin here.
commands:
  allowed:
    - menu
    - profile
    - settings
    - leaderboards
    - lb
    - store
    - buy
    - shop
    - cosmetics
    - joinmessage
    - website
    - stats
    - duty
    # zChat
    - msg
    - tell
    - w
    - whisper
    - m
    - pm
    - reply
    - r
    - togglechat
    - tc
    # xUtilities' links
    - rules
    - wiki
    - guide
    - apply
    - discord
