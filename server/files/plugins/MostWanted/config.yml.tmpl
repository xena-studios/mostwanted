

# The resource pack (pack/ in the repo), published as the "pack" GitHub release.
# Java players get it as they join; its SHA-1 is read from sha1-url, so publishing
# a new pack needs no change here. Empty url turns it off. Without the pack, items
# show as the vanilla items they're made from: the game still works.
resource-pack:
  url: https://github.com/xena-studios/mostwanted/releases/download/pack/mostwanted-pack.zip
  sha1-url: https://github.com/xena-studios/mostwanted/releases/download/pack/mostwanted-pack.sha1
  required: true
