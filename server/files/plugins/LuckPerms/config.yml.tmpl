# LuckPerms: only what MostWanted changes. Rendered by server/install.sh from
# <server-dir>/.env, so the database password never enters this repo.
server: mostwanted
storage-method: ${LUCKPERMS_STORAGE}
data:
  address: ${DB_HOST}
  database: ${DB_NAME}
  username: ${DB_USER}
  password: ${DB_PASSWORD}
  table-prefix: luckperms_
