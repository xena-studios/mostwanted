# Copy to <server-dir>/.env and fill in. install.sh renders the *.tmpl configs
# with these. Never commit the real file.

# PostgreSQL on the VPS (see docs/04-tech.md). LuckPerms and the core plugin share it.
DB_HOST=localhost:5432
DB_NAME=mostwanted
DB_USER=mostwanted
DB_PASSWORD=

# postgresql on the live server; h2 (a local file) for testing without a database.
LUCKPERMS_STORAGE=postgresql
