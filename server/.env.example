# Copy to <server-dir>/.env and fill in. install.sh renders the *.tmpl configs
# with these. Never commit the real file.

# The database: Raptor's PostgreSQL, from the game server's Databases tab in Raptor
# (docs/12-launch.md, step 5). LuckPerms, LibertyBans and the core plugin share it. Keep single quotes out of the password: the configs quote it.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mostwanted
DB_USER=mostwanted
DB_PASSWORD=

# The live server uses PostgreSQL. To test without a database, use local files:
# LUCKPERMS_STORAGE=h2 and LIBERTYBANS_DATABASE=HSQLDB.
LUCKPERMS_STORAGE=postgresql
LIBERTYBANS_DATABASE=POSTGRES

# Tebex's secret key for the webstore's game server (Tebex: Integrations → Game
# servers), so the server delivers purchases. Write none until the store is set up.
TEBEX_SECRET=none
