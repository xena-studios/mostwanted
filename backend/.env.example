# Copy to the backend's server folder as .env and fill in; start.sh reads it.
# Never commit the real file.

# The same PostgreSQL as the game (server/.env).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mostwanted
DB_USER=mostwanted
DB_PASSWORD=
DB_POOL_SIZE=4

# The API. Behind Cloudflare, the firewall only lets Cloudflare in, so its
# CF-Connecting-IP header is the visitor's real IP.
API_HOST=0.0.0.0
API_PORT=8080
API_ORIGINS=https://mostwantedmc.com
API_BEHIND_CLOUDFLARE=true
API_REQUESTS_PER_MINUTE=120

# Must match clock.timezone in the game's config.yml, or the month and week
# boards won't line up with the game's.
TIMEZONE=America/New_York
SITE_URL=https://mostwantedmc.com

# The bot's token, from the Discord developer portal. Empty switches the bot off.
DISCORD_TOKEN=

# Signing in with Discord. The secret is the app's OAuth2 client secret; empty
# switches Discord sign-in off. Add API_URL + /v1/auth/discord/callback as a
# redirect in the developer portal (OAuth2 > Redirects).
API_URL=https://api.mostwantedmc.com
DISCORD_CLIENT_ID=1564123260562440303
DISCORD_CLIENT_SECRET=

# The session cookie is shared by the site and the API. COOKIE_SECURE=false only
# for testing over plain http on localhost.
COOKIE_DOMAIN=.mostwantedmc.com
COOKIE_SECURE=true
