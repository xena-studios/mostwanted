/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' https://mc-heads.net; font-src 'self'; connect-src 'self' https://api.mostwantedmc.com https://headless.tebex.io; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; manifest-src 'self'; require-trusted-types-for 'script'
  Cross-Origin-Opener-Policy: same-origin
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/site.webmanifest
  Content-Type: application/manifest+json

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/store/*
  Cache-Control: public, max-age=86400

/store.json
  Cache-Control: public, max-age=300
