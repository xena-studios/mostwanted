---
import { Shield, Users, Video } from "@lucide/astro";
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import { site, signInOpen } from "../site";
import rocks from "../brand/scene-rocks.png";

const apps = [
  {
    id: "guard",
    icon: Shield,
    title: "Guard",
    lead: "Patrol the prison, answer alarms, and bring criminals in. Every arrest pays the bounty.",
    needs: [
      "You've played MostWanted and know how escapes, robberies and arrests work",
      "No recent bans or serious warnings",
      "You'll use guard powers on rule-of-the-game targets, never on rivals",
      "You agree to the guard code (no helping criminals, no abusing arrests)",
    ],
  },
  {
    id: "staff",
    icon: Users,
    title: "Staff",
    lead: "Help run the server: handle reports, keep chat clean, and help new players.",
    needs: ["Active on the server and the Discord", "Calm, fair and good at explaining things", "A clean record", "13 or older"],
  },
  {
    id: "creator",
    icon: Video,
    title: "Creator",
    lead: "Make videos or stream MostWanted. Get a rank, a spot on the Creators page, and early looks at new features.",
    needs: ["Regular MostWanted content on YouTube, Twitch or TikTok", "Content that follows the rules", "Any audience size"],
  },
];
---
<Base title="Apply" description="Apply to be a guard, join the staff team, or join the MostWanted creator program.">
  <PageHero title="Apply" lead="Guards, staff and creators are all picked by application." image={rocks} />
  <section class="section">
    <div class="wrap">
      {!signInOpen && <p class="note"><strong>Applications open at launch.</strong> You'll apply here: sign in, link your Minecraft account, fill in the form, and staff get back to you.</p>}
      <ul class="apps">
        {
          apps.map((a) => (
            <li class="panel app" id={a.id}>
              <div class="app-head">
                <a.icon aria-hidden="true" />
                <h2>{a.title}</h2>
              </div>
              <p class="lead-in">{a.lead}</p>
              <h3 class="label">What we look for</h3>
              <ul class="needs">
                {a.needs.map((n) => (
                  <li>{n}</li>
                ))}
              </ul>
              {signInOpen ? (
                <a class="button primary" href={`?kind=${a.id}#form`} data-apply={a.id}>Apply</a>
              ) : (
                <span class="button" aria-disabled="true">Opens at launch</span>
              )}
            </li>
          ))
        }
      </ul>

      {
        signInOpen && (
          <section class="panel apply" id="form" data-apply-form data-api={site.api} hidden>
            <h2 data-title></h2>
            <p class="lead-in" data-signed-out hidden>
              Applications live on your MostWanted account. <a data-sign-in href="/login">Sign in</a>, then come back here.
            </p>
            <p class="lead-in" data-no-minecraft hidden>
              Link your Minecraft account on your <a href="/account">account page</a> first, so we know who's applying.
            </p>
            <form class="form" data-form hidden>
              <div class="questions" data-questions></div>
              <p class="alert" role="alert" data-error hidden></p>
              <button class="button primary" type="submit">Send application</button>
              <p class="hint">Staff read every one. You'll hear back on your <a href="/account#applications">account page</a>, by Discord DM if you've linked Discord, and in game.</p>
            </form>
            <p class="alert good" role="status" data-sent hidden>Sent! Staff will get back to you: watch your <a href="/account#applications">account page</a>.</p>
          </section>
        )
      }
    </div>
  </section>
</Base>

<script>
  import { ApiError, call, type Me } from "../scripts/api";
  import { KINDS, el, type Forms } from "../scripts/support";

  const root = document.querySelector<HTMLElement>("[data-apply-form]");
  const kind = new URLSearchParams(location.search).get("kind") ?? "";

  if (root && kind in KINDS) {
    const api = root.dataset.api!;
    const $ = <T extends HTMLElement>(name: string) => root.querySelector<T>(`[data-${name}]`)!;
    const form = $<HTMLFormElement>("form");
    root.hidden = false;
    $("title").textContent = `Apply: ${KINDS[kind]}`;
    $<HTMLAnchorElement>("sign-in").href = `/login?next=${encodeURIComponent(`/apply?kind=${kind}#form`)}`;
    document.getElementById(kind)?.classList.add("chosen");

    Promise.all([call<Me>(api, "GET", "/v1/me"), call<Forms>(api, "GET", "/v1/forms")]).then(
      ([me, forms]) => {
        if (!me!.minecraft) {
          $("no-minecraft").hidden = false;
          return;
        }
        for (const q of forms!.applications[kind]) {
          const label = el("label", "", q.label + (q.required ? "" : " (if you like)"));
          if (q.hint) label.append(el("span", "hint", q.hint));
          let input: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement;
          if (q.options.length) {
            input = el("select", "input");
            for (const option of q.options) input.append(el("option", "", option));
          } else if (q.max > 200) {
            input = el("textarea", "input");
            input.maxLength = q.max;
          } else {
            input = el("input", "input");
            input.maxLength = q.max;
          }
          input.name = q.id;
          input.required = q.required;
          label.append(input);
          $("questions").append(label);
        }
        form.hidden = false;
      },
      (e) => {
        if (e instanceof ApiError && e.status === 401) $("signed-out").hidden = false;
        else {
          $("error").textContent = (e as Error).message;
          $("error").hidden = false;
          form.hidden = false;
        }
      },
    );

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const button = form.querySelector<HTMLButtonElement>("button")!;
      button.disabled = true;
      const answers = Object.fromEntries(new FormData(form).entries());
      try {
        await call(api, "POST", "/v1/me/applications", { kind, answers });
        form.hidden = true;
        $("sent").hidden = false;
      } catch (e) {
        $("error").textContent = (e as Error).message;
        $("error").hidden = false;
        button.disabled = false;
      }
    });
  }
</script>

<style>
  .apps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-4);
    margin-top: var(--s-6);
    padding: 0;
    list-style: none;
  }

  .app {
    display: grid;
    grid-template-rows: auto auto auto 1fr auto;
    gap: var(--s-3);
    padding: var(--s-6) var(--s-5);
    scroll-margin-top: 6rem;
  }

  .app:target,
  .app.chosen {
    border-color: var(--orange);
  }

  [hidden] {
    display: none !important;
  }

  .apply {
    display: grid;
    gap: var(--s-4);
    max-width: 44rem;
    margin-top: var(--s-6);
    padding: var(--s-6);
    scroll-margin-top: 6rem;
  }

  .apply a {
    color: var(--orange);
  }

  .questions {
    display: grid;
    gap: var(--s-4);
  }

  .app-head {
    display: flex;
    align-items: center;
    gap: var(--s-3);
  }

  .app-head :global(svg) {
    width: 2rem;
    height: 2rem;
    color: var(--orange);
  }

  h2 {
    font-size: 2rem;
  }

  .lead-in {
    color: var(--muted);
  }

  .label {
    margin-top: var(--s-2);
    font-family: var(--pixel);
  }

  .needs {
    display: grid;
    gap: var(--s-2);
    padding-left: 1.2rem;
    color: var(--muted);
  }

  .needs li::marker {
    color: var(--orange);
  }

  .button {
    justify-self: start;
  }

  @media (max-width: 60rem) {
    .apps {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
