---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import { site } from "../site";
---
<Base title="Your account" description="Your MostWanted account: linked accounts, tickets and applications." noindex>
  <PageHero title="Your account" lead="Your linked accounts, tickets and applications, in one place." />
  <section class="section">
    <div class="wrap account" data-account data-api={site.api}>
      <p class="error" role="alert" data-error hidden></p>
      <p class="loading" data-loading>Loading…</p>

      <div class="grid" data-ready hidden>
        <section class="panel side" aria-labelledby="mc-title">
          <h2 id="mc-title">Minecraft</h2>
          <div data-mc-linked hidden>
            <p class="who"><img data-mc-head alt="" width="48" height="48" /> <strong data-mc-name></strong></p>
            <a class="button" data-mc-stats>See your stats</a>
          </div>
          <form data-mc-form hidden>
            <label for="link-code">Type <code>/website</code> in game, then enter the code to link your Minecraft account.</label>
            <div class="field">
              <input id="link-code" class="input pixel" name="code" placeholder="ABC234" autocomplete="one-time-code" autocapitalize="characters" spellcheck="false" maxlength="7" required />
              <button class="button primary" type="submit">Link</button>
            </div>
          </form>
        </section>

        <section class="panel side" aria-labelledby="discord-title">
          <h2 id="discord-title">Discord</h2>
          <p class="who" data-discord-linked hidden><strong data-discord-name></strong></p>
          <div data-discord-link hidden>
            <p data-discord-soon hidden>Linking Discord opens soon: you'll get the Linked role and replies to your tickets as DMs.</p>
            <div data-discord-ready>
            <p>Link Discord to get the Linked role and replies to your tickets as DMs.</p>
            <a class="button primary" href={`${site.api}/v1/auth/discord`}>Link Discord</a>
            </div>
          </div>
        </section>
      </div>

      <p class="linked" data-linked hidden>Both linked: you have the <strong>Linked</strong> role on our Discord.</p>

      <a class="panel staff-link" href="/panel" data-staff hidden><strong>Staff panel</strong> <span>Tickets and applications</span></a>

      <section class="panel list" id="notifications" data-ready hidden aria-labelledby="notices-title">
        <h2 id="notices-title">Notifications</h2>
        <ol class="items" data-notices></ol>
        <p class="none" data-no-notices>Nothing yet. Staff replies and application decisions show up here, by Discord DM if you've linked Discord, and in game.</p>
      </section>

      <section class="panel list" id="tickets" data-ready hidden aria-labelledby="tickets-title">
        <div class="list-head">
          <h2 id="tickets-title">Tickets</h2>
          <a class="button" href="/support#ticket">Open a ticket</a>
        </div>
        <ol class="items" data-tickets></ol>
        <p class="none" data-no-tickets>No tickets. Reports, appeals, bugs and questions go through <a href="/support#ticket">Support</a>.</p>
      </section>

      <section class="panel list" id="applications" data-ready hidden aria-labelledby="applications-title">
        <div class="list-head">
          <h2 id="applications-title">Applications</h2>
          <a class="button" href="/apply">Apply</a>
        </div>
        <ol class="items" data-applications></ol>
        <p class="none" data-no-applications>None. Want to be a guard, join the staff or the creator program? See <a href="/apply">Apply</a>.</p>
      </section>

      <section class="panel danger" data-ready hidden aria-labelledby="manage-title">
        <h2 id="manage-title">Manage</h2>
        <div class="actions">
          <button class="button" type="button" data-logout>Sign out</button>
          <button class="button" type="button" data-delete>Delete account</button>
          <button class="button really" type="button" data-really hidden>Yes, delete it</button>
        </div>
        <p class="small">Deleting removes your website account and its links. Your in-game progress stays; to delete that too, email <a href={`mailto:${site.email}`}>{site.email}</a> (see <a href="/privacy">Privacy</a>).</p>
      </section>
    </div>
  </section>
</Base>

<script>
  import { ApiError, call, type Me } from "../scripts/api";
  import { APPLICATION_STATES, KINDS, TICKET_STATES, chip, el, when, type Application, type Notice, type Ticket } from "../scripts/support";

  // Back from signing in with Discord, which always lands here: on to where they were going.
  const next = sessionStorage.getItem("mw-next");
  if (next) {
    sessionStorage.removeItem("mw-next");
    location.replace(next);
  }

  const root = document.querySelector<HTMLElement>("[data-account]")!;
  const api = root.dataset.api!;
  const $ = <T extends HTMLElement>(name: string) => root.querySelector<T>(`[data-${name}]`)!;
  const error = $("error");

  function show(message: string) {
    error.textContent = message;
    error.hidden = false;
  }

  const linkErrors: Record<string, string> = {
    "already-linked": "This account already has a Discord account linked.",
    "taken": "That Discord account is linked to someone else's Minecraft account.",
  };
  const fromDiscord = new URLSearchParams(location.search).get("error");
  if (fromDiscord) show(linkErrors[fromDiscord] ?? "Couldn't link Discord. Try again.");

  function render(me: Me) {
    $("loading").hidden = true;
    root.querySelectorAll<HTMLElement>("[data-ready]").forEach((el) => (el.hidden = false));
    $("mc-linked").hidden = !me.minecraft;
    $("mc-form").hidden = !!me.minecraft;
    if (me.minecraft) {
      $("mc-name").textContent = me.minecraft.name;
      $<HTMLImageElement>("mc-head").src = `https://mc-heads.net/avatar/${me.minecraft.uuid}/48`;
      $<HTMLAnchorElement>("mc-stats").href = `/player?name=${encodeURIComponent(me.minecraft.name)}`;
    }
    $("discord-linked").hidden = !me.discord;
    $("discord-link").hidden = !!me.discord;
    if (me.discord) $("discord-name").textContent = me.discord.name;
    else
      fetch(`${api}/health`, { signal: AbortSignal.timeout(8000) })
        .then((response) => response.json())
        .then((health) => {
          const on = health.discordSignIn === "on";
          $("discord-ready").hidden = !on;
          $("discord-soon").hidden = on;
        })
        .catch(() => {});
    $("linked").hidden = !me.linked;
    $("staff").hidden = !me.staff;
  }

  function item(title: Node | string, meta: string, state: HTMLElement | null, href: string | null): HTMLLIElement {
    const head = el("p", "item-head", el("strong", "", title), state);
    const body = el("div", "", head, el("p", "item-meta", meta));
    if (!href) return el("li", "item", body);
    const a = el("a", "item-link", body);
    a.href = href;
    return el("li", "item", a);
  }

  async function lists() {
    const [notices, tickets, applications] = await Promise.all([
      call<Notice[]>(api, "GET", "/v1/me/notifications"),
      call<Ticket[]>(api, "GET", "/v1/me/tickets"),
      call<Application[]>(api, "GET", "/v1/me/applications"),
    ]);
    $("notices").replaceChildren(
      ...notices!.map((n) => item(n.text, when(n.createdAt), n.read ? null : chip("open", "New"), n.link)),
    );
    $("no-notices").hidden = notices!.length > 0;
    $("tickets").replaceChildren(
      ...tickets!.map((t) => item(t.subject, `Updated ${when(t.updatedAt)}`, chip(t.status, TICKET_STATES[t.status]), `/ticket?id=${t.id}`)),
    );
    $("no-tickets").hidden = tickets!.length > 0;
    $("applications").replaceChildren(
      ...applications!.map((a) => {
        const li = item(KINDS[a.kind] ?? a.kind, `Sent ${when(a.createdAt)}`, chip(a.status, APPLICATION_STATES[a.status]), null);
        if (a.note) li.append(el("p", "note-from", el("strong", "", `${a.decidedBy ?? "Staff"}: `), a.note));
        return li;
      }),
    );
    $("no-applications").hidden = applications!.length > 0;
    // Seen now: the next visit shows them as read.
    if (notices!.some((n) => !n.read)) call(api, "POST", "/v1/me/notifications/read").catch(() => {});
  }

  call<Me>(api, "GET", "/v1/me").then(
    (me) => {
      render(me!);
      lists().catch((e) => show((e as Error).message));
    },
    (e) => {
      if (e instanceof ApiError && e.status === 401) location.replace("/login");
      else {
        $("loading").hidden = true;
        show((e as Error).message);
      }
    },
  );

  const form = $<HTMLFormElement>("mc-form");
  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    const button = form.querySelector("button")!;
    button.disabled = true;
    try {
      render((await call<Me>(api, "POST", "/v1/me/minecraft", { code: new FormData(form).get("code") }))!);
      error.hidden = true;
    } catch (e) {
      show((e as Error).message);
    }
    button.disabled = false;
  });

  $("logout").addEventListener("click", async () => {
    await call(api, "POST", "/v1/auth/logout").catch(() => {});
    location.assign("/");
  });

  // Two steps, so one slip doesn't delete it.
  $("delete").addEventListener("click", () => {
    $("delete").hidden = true;
    $("really").hidden = false;
    $("really").focus();
  });
  $("really").addEventListener("click", async () => {
    try {
      await call(api, "DELETE", "/v1/me");
      location.assign("/");
    } catch (e) {
      show((e as Error).message);
    }
  });
</script>

<style>
  /* Layout rules below set display, which would otherwise beat the hidden attribute. */
  [hidden] {
    display: none !important;
  }

  .account {
    display: grid;
    gap: var(--s-5);
    max-width: 52rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: var(--s-4);
  }

  .side,
  .danger,
  .list {
    display: grid;
    align-content: start;
    gap: var(--s-4);
    padding: var(--s-6);
  }

  .side > div,
  form {
    display: grid;
    gap: var(--s-3);
  }

  h2 {
    font-size: 1.75rem;
    color: var(--orange);
  }

  p,
  label {
    color: var(--muted);
  }

  .who {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    font-size: 1.25rem;
  }

  .who img {
    border-radius: 8px;
    image-rendering: pixelated;
  }

  .who strong,
  .linked strong {
    color: var(--text);
  }

  [data-discord-ready] {
    display: grid;
    gap: var(--s-3);
  }

  .field .input {
    font-size: 1.25rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }

  .really {
    background: var(--red);
    border-color: var(--orange-deep);
    /* Dark text: white on this red is too faint to read. */
    color: var(--ink);
  }

  .error {
    padding: var(--s-3) var(--s-4);
    border-radius: 10px;
    background: color-mix(in srgb, #ff3333 15%, transparent);
    color: var(--text);
  }

  .small {
    font-size: 0.875rem;
  }

  .list-head {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    align-items: center;
    justify-content: space-between;
  }

  .items {
    display: grid;
    gap: var(--s-2);
    padding: 0;
    list-style: none;
  }

  .items :global(.item) {
    padding: var(--s-3) var(--s-4);
    border: 2px solid var(--rule);
    border-radius: 10px;
  }

  .items :global(.item-link) {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .items :global(.item:has(.item-link):hover) {
    border-color: var(--orange);
  }

  .items :global(.item-head) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    align-items: center;
    justify-content: space-between;
    color: var(--text);
  }

  .items :global(.item-meta) {
    font-size: 0.875rem;
  }

  .items :global(.note-from) {
    margin-top: var(--s-2);
    padding-left: var(--s-3);
    border-left: 3px solid var(--rule);
  }

  .none a {
    color: var(--orange);
  }

  .staff-link {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    align-items: baseline;
    padding: var(--s-4) var(--s-6);
    border-color: var(--orange);
    color: var(--text);
    text-decoration: none;
  }

  .staff-link span {
    color: var(--muted);
  }
</style>
