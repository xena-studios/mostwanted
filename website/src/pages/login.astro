---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import monogram from "../brand/monogram.png";
import background from "../brand/background.png";
import { site, signInOpen } from "../site";
---
<Base title="Sign in" description="Sign in to MostWanted with Discord or a code from the game, to link your accounts, see your stats and apply." noindex>
  <section class="login">
    <Image class="bg" src={background} alt="" widths={[960, 1920]} sizes="100vw" loading="eager" />
    <div class="panel card" data-login data-api={site.api}>
      <Image src={monogram} alt="" widths={[200]} sizes="6rem" class="mono" />
      <h1>Sign in</h1>
      <p>Link your Minecraft and Discord accounts, see your stats, and apply. No passwords.</p>
      <p class="error" role="alert" data-error hidden></p>
      {
        signInOpen ? (
          <>
            <a class="button primary discord" href={`${site.api}/v1/auth/discord`}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M20.3 4.4A19.6 19.6 0 0 0 15.4 3l-.6 1.3a18.2 18.2 0 0 0-5.6 0L8.6 3a19.6 19.6 0 0 0-4.9 1.4C.6 9 0 13.5.3 18a19.8 19.8 0 0 0 6 3l1.3-2.1a12.8 12.8 0 0 1-2-1l.5-.4a14 14 0 0 0 11.8 0l.5.4-2 1 1.3 2.1a19.8 19.8 0 0 0 6-3c.4-5.2-.7-9.6-3.4-13.6ZM8.5 15.3c-1.2 0-2.1-1-2.1-2.3s.9-2.3 2.1-2.3 2.1 1 2.1 2.3-.9 2.3-2.1 2.3Zm7 0c-1.2 0-2.1-1-2.1-2.3s.9-2.3 2.1-2.3 2.1 1 2.1 2.3-.9 2.3-2.1 2.3Z"/></svg>
              Continue with Discord
            </a>
            <p class="or"><span>or with a code from the game</span></p>
            <form class="code" data-code-form>
              <label for="code">Type <code>/website</code> in game, then enter the code it shows.</label>
              <div class="field">
                <input id="code" class="input pixel" name="code" placeholder="ABC234" autocomplete="one-time-code" autocapitalize="characters" spellcheck="false" maxlength="7" required />
                <button class="button primary" type="submit">Sign in</button>
              </div>
            </form>
          </>
        ) : (
          <>
            <span class="button primary discord" aria-disabled="true">Continue with Discord</span>
            <p class="soon">Sign-in opens with the server.</p>
          </>
        )
      }
      <p class="small">By signing in you agree to the <a href="/terms">Terms</a> and <a href="/privacy">Privacy</a> policy.</p>
    </div>
  </section>
</Base>

<script>
  import { call, type Me } from "../scripts/api";

  const card = document.querySelector<HTMLElement>("[data-login]")!;
  const api = card.dataset.api!;
  const error = card.querySelector<HTMLElement>("[data-error]")!;
  const form = card.querySelector<HTMLFormElement>("[data-code-form]");

  function show(message: string) {
    error.textContent = message;
    error.hidden = false;
  }

  if (new URLSearchParams(location.search).get("error") === "discord") {
    show("Discord sign-in didn't finish. Try again.");
  }

  // Already signed in: straight to the account page (only once sign-in is open).
  if (form) call<Me>(api, "GET", "/v1/me").then(() => location.replace("/account"), () => {});

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const button = form.querySelector("button")!;
    button.disabled = true;
    try {
      await call<Me>(api, "POST", "/v1/auth/code", { code: new FormData(form).get("code") });
      location.assign("/account");
    } catch (e) {
      show((e as Error).message);
      button.disabled = false;
    }
  });
</script>

<style>
  /* Layout rules below set display, which would otherwise beat the hidden attribute. */
  [hidden] {
    display: none !important;
  }

  .login {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 100svh;
    padding: 6rem var(--s-5) var(--s-7);
    overflow: hidden;
    isolation: isolate;
  }

  .login :global(.bg) {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .login::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: color-mix(in srgb, var(--dusk) 55%, transparent);
  }

  .card {
    display: grid;
    justify-items: center;
    gap: var(--s-4);
    width: min(28rem, 100%);
    padding: var(--s-7) var(--s-6);
    text-align: center;
  }

  .card :global(.mono) {
    width: 6rem;
    height: auto;
  }

  h1 {
    font-size: 2.75rem;
    text-transform: uppercase;
  }

  .card p,
  label {
    color: var(--muted);
  }

  .discord {
    width: 100%;
    background: linear-gradient(to bottom, #7983f5, #5865f2);
    border-color: #3c45a5;
    color: white;
  }

  .discord svg {
    width: 1.4rem;
    height: 1.4rem;
  }

  .or {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    width: 100%;
    font-size: 0.9375rem;
  }

  .or::before,
  .or::after {
    content: "";
    flex: 1;
    border-top: 2px solid var(--rule);
  }

  .code {
    display: grid;
    gap: var(--s-3);
    width: 100%;
  }

  .code .input {
    font-size: 1.5rem;
    letter-spacing: 0.2em;
    text-align: center;
    text-transform: uppercase;
  }

  .error {
    width: 100%;
    padding: var(--s-3);
    border-radius: 10px;
    background: color-mix(in srgb, #ff3333 15%, transparent);
    color: var(--text) !important;
  }

  .soon {
    font-family: var(--pixel);
    font-size: 1.25rem;
  }

  .small {
    font-size: 0.875rem;
  }
</style>
