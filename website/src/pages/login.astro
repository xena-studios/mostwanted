---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import monogram from "../brand/monogram.png";
import background from "../brand/background.png";
import { site } from "../site";
---
<Base title="Sign in" description="Sign in to MostWanted with Discord to link your Minecraft account, manage your profile and apply." noindex>
  <section class="login">
    <Image class="bg" src={background} alt="" widths={[960, 1920]} sizes="100vw" loading="eager" />
    <div class="panel card">
      <Image src={monogram} alt="" widths={[200]} sizes="6rem" class="mono" />
      <h1>Sign in</h1>
      <p>Sign in with Discord to link your Minecraft account, see your stats, manage your profile and apply.</p>
      <span class="button primary discord" aria-disabled="true">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M20.3 4.4A19.6 19.6 0 0 0 15.4 3l-.6 1.3a18.2 18.2 0 0 0-5.6 0L8.6 3a19.6 19.6 0 0 0-4.9 1.4C.6 9 0 13.5.3 18a19.8 19.8 0 0 0 6 3l1.3-2.1a12.8 12.8 0 0 1-2-1l.5-.4a14 14 0 0 0 11.8 0l.5.4-2 1 1.3 2.1a19.8 19.8 0 0 0 6-3c.4-5.2-.7-9.6-3.4-13.6ZM8.5 15.3c-1.2 0-2.1-1-2.1-2.3s.9-2.3 2.1-2.3 2.1 1 2.1 2.3-.9 2.3-2.1 2.3Zm7 0c-1.2 0-2.1-1-2.1-2.3s.9-2.3 2.1-2.3 2.1 1 2.1 2.3-.9 2.3-2.1 2.3Z"/></svg>
        Continue with Discord
      </span>
      {!site.open && <p class="soon">Sign-in opens with the server.</p>}
    </div>
  </section>
</Base>

<style>
  .login {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 100svh;
    padding: 6rem var(--s-5) var(--s-7);
    overflow: hidden;
    isolation: isolate;
  }

  .login :global(.bg) {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .login::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: color-mix(in srgb, var(--dusk) 55%, transparent);
  }

  .card {
    display: grid;
    justify-items: center;
    gap: var(--s-4);
    width: min(26rem, 100%);
    padding: var(--s-7) var(--s-6);
    text-align: center;
  }

  .card :global(.mono) {
    width: 6rem;
    height: auto;
  }

  h1 {
    font-size: 2.75rem;
    text-transform: uppercase;
  }

  .card p {
    color: var(--muted);
  }

  .discord {
    width: 100%;
    background: linear-gradient(to bottom, #7983f5, #5865f2);
    border-color: #3c45a5;
    color: white;
  }

  .discord svg {
    width: 1.4rem;
    height: 1.4rem;
  }

  .soon {
    font-family: var(--pixel);
    font-size: 1.25rem;
  }
</style>
