---
// The top of every inner page: a slice of the blurred desert behind a big
// uppercase title, the same frame on every page (Shore's layout).
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import background from "../brand/background.png";

interface Props {
  title: string;
  lead?: string;
  image?: ImageMetadata;
}

const { title, lead, image = background } = Astro.props;
---
<header class="page-hero">
  <Image class="bg" src={image} alt="" widths={[960, 1440, 1920]} sizes="100vw" loading="eager" fetchpriority="high" />
  <div class="wrap copy">
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</header>

<style>
  .page-hero {
    position: relative;
    display: grid;
    align-items: end;
    min-height: clamp(18rem, 36vw, 26rem);
    padding-top: 4rem;
    overflow: hidden;
    isolation: isolate;
  }

  .page-hero :global(.bg) {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(2px) saturate(1.05);
    transform: scale(1.03);
  }

  .page-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to bottom, color-mix(in srgb, var(--dusk) 45%, transparent), color-mix(in srgb, var(--dusk) 70%, transparent) 55%, var(--dusk));
  }

  .copy {
    padding-block: var(--s-7) var(--s-6);
  }

  h1 {
    font-size: var(--t-mega);
    text-transform: uppercase;
    text-shadow: 0 4px 0 var(--orange-deep), 0 10px 30px color-mix(in srgb, black 50%, transparent);
  }

  .lead {
    margin-top: var(--s-4);
    color: var(--text);
    text-shadow: 0 1px 10px var(--dusk);
  }
</style>
